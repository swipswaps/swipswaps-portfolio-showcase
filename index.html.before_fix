<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>swipswaps · 3D Portfolio – Fully Working</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        body{background:radial-gradient(circle at 20% 30%,#0a0f1a,#03050a);font-family:system-ui,sans-serif;overflow:hidden}
        .header{position:fixed;top:0;left:0;right:0;background:rgba(8,12,20,0.96);backdrop-filter:blur(20px);padding:12px 24px;z-index:200;border-bottom:1px solid rgba(94,255,224,0.35)}
        .header h1{font-size:1.2rem;color:white}
        .header p{font-size:0.7rem;color:#88aacc}
        .social-links{position:fixed;top:12px;right:20px;display:flex;gap:10px;z-index:200}
        .social-links a{color:#e8edf5;text-decoration:none;font-size:12px;background:rgba(8,12,20,0.85);padding:6px 14px;border-radius:40px;border:1px solid rgba(94,255,224,0.3)}
        .social-links a:hover{color:#5effe0;border-color:#5effe0}
        .main-layout{display:flex;flex-direction:row!important;height:100vh;padding-top:80px;overflow:hidden}
        .canvas-panel{flex:2.5;margin:12px 6px 12px 16px;background:rgba(0,0,0,0.2);border-radius:24px;overflow:hidden;position:relative; height: 100%;}
        #canvas-container{width:100%;height:100%;background:#050b1a; min-height: 500px;}
        .info-panel{flex:1.2;min-width:320px;background:rgba(8,12,22,0.94);backdrop-filter:blur(24px);margin:12px 16px 12px 6px;border-radius:24px;border:1px solid rgba(94,255,224,0.3);display:flex;flex-direction:column;overflow:hidden}
        .panel-header{padding:16px 18px;border-bottom:1px solid rgba(94,255,224,0.15)}
        .panel-header h2{color:#5effe0;font-size:1.1rem}
        .panel-scroll{flex:1;overflow-y:auto;padding:14px 16px}
        .status-badge{font-size:11px;padding:4px 10px;border-radius:20px;display:inline-block;margin-bottom:14px;font-weight:500}
        .online{background:rgba(30,70,50,0.9);color:#5effe0;border:1px solid #5effe0}
        .offline{background:rgba(70,40,40,0.9);color:#ffaa88;border:1px solid #ffaa88}
        .checking{background:rgba(70,70,40,0.9);color:#ffcc88;border:1px solid #ffcc88}
        .search-area{background:#0a0a14;border:1px solid #2a2a3e;border-radius:60px;padding:8px 16px;margin-bottom:18px;display:flex;gap:8px}
        .search-area input{flex:1;background:transparent;border:none;color:white;font-family:monospace;outline:none;font-size:13px}
        .search-area input::placeholder{color:#777}
        .search-area button{background:#2e7d64;color:#e8edf5;border:none;border-radius:40px;padding:5px 16px;cursor:pointer;font-weight:600}
        .search-area button:hover{background:#5effe0;color:#0a0f1a}
        .collapsible{margin-bottom:18px;border:1px solid rgba(94,255,224,0.2);border-radius:16px;overflow:hidden}
        .collapsible-header{background:rgba(15,15,26,0.8);padding:10px 14px;cursor:pointer;color:#5effe0;display:flex;justify-content:space-between}
        .collapsible-content{padding:12px 14px;background:rgba(8,12,22,0.5);display:none}
        .collapsible-content.active{display:block}
        .repo-current{background:rgba(10,10,20,0.9);border-radius:14px;padding:10px 12px;border-left:3px solid #5effe0}
        .repo-current-name{font-size:14px;font-weight:700;color:#5effe0}
        .repo-current-details{font-size:11px;color:#aaccff;margin-top:5px}
        .section-title{font-size:11px;font-weight:700;color:#5effe0;margin:10px 0 6px;text-transform:uppercase}
        .related-item{background:rgba(20,20,35,0.95);border-radius:12px;padding:8px 12px;margin-bottom:8px;cursor:pointer;border:1px solid #2a2a3e}
        .related-item:hover{background:rgba(40,40,60,0.95);border-color:#5effe0}
        .related-name{font-weight:700;font-size:12px;color:#e8edf5}
        .related-lang{font-size:10px;color:#88aacc;margin-top:2px}
        .related-desc{font-size:10px;color:#aaccff;margin-top:2px}
        .code-snippet{background:#0a0a0f;border-radius:10px;padding:8px 10px;font-family:monospace;font-size:10px;color:#b8ffb8;border:1px solid #2a2a3e;white-space:pre-wrap}
        .empty-message{color:#aaa;text-align:center;padding:20px}
        .hint{position:fixed;bottom:14px;right:18px;background:rgba(0,0,0,0.7);padding:5px 14px;border-radius:40px;font-size:10px;color:#ccc;z-index:200}
        .debug-panel{position:fixed;bottom:14px;left:18px;background:rgba(0,0,0,0.9);backdrop-filter:blur(8px);padding:8px 12px;border-radius:12px;font-family:monospace;font-size:10px;color:#0f0;z-index:300;max-width:380px;pointer-events:auto;border:1px solid #ff66cc;max-height:250px;overflow-y:auto}
        .debug-panel button{background:#2e7d64;border:none;color:white;padding:2px 8px;border-radius:8px;cursor:pointer;margin:2px;font-size:9px}
        .error-message{color:#ff8888;background:#330000;padding:10px;border-radius:8px;margin:10px}
    </style>
</head>
<body>
<div class="header"><h1>José Melendez</h1><p>DevOps Data Scientist · AI-Augmented Reliability Engineer</p></div>
<div class="social-links"><a href="https://github.com/swipswaps" target="_blank">GitHub</a><a href="https://x.com/swipswaps" target="_blank">X/Twitter</a></div>
<div class="hint">🖱️ Drag to rotate • Single‑click to lock • Double‑click to open • Right‑click enabled</div>
<div class="main-layout"><div class="canvas-panel"><div id="canvas-container"></div></div>
<div class="info-panel"><div class="panel-header"><h2>🔍 Code Explorer</h2><p>Single‑click to lock – search inside code snippets</p></div>
<div class="panel-scroll" id="panel-scroll"><div id="status-area"></div><div class="search-area"><input type="text" id="searchInput" placeholder="🔎 Search code snippets...">
    <select id="searchMode" style="background:#2a2a2a; color:white; border-radius:30px; padding:5px 10px; font-size:12px;">
        <option value="readme">📄 Search READMEs (local)</option>
        <option value="github">🔍 Search code (GitHub API) – requires local backend running</option>
    </select>
    <button id="searchBtn">Search</button></div>
<div id="hoverSection" class="collapsible"><div class="collapsible-header" onclick="toggleCollapsible(this)"><span>📍 Repository Info</span><span class="indicator">▼</span></div><div class="collapsible-content active" id="hoverContent"><div class="empty-message">✨ Click any repository to lock it</div></div></div>
<div id="searchSection" class="collapsible"><div class="collapsible-header" onclick="toggleCollapsible(this)"><span>🔎 Search Results</span><span class="indicator">▼</span></div><div class="collapsible-content active" id="searchResults"><div class="empty-message">Search results appear here</div></div></div></div></div></div>
<div class="debug-panel" id="debugPanel"><div><strong>📡 VERBOSE LOGS</strong> <button id="downloadLogs">📥 Save</button> <button id="clearLogs">🗑️ Clear</button></div><div id="debugText">Initializing...</div></div>

<script>
    // ---------- ABSOLUTE LOGGING (captures everything) ----------
    window.logQueue = [];
    window.debugDiv = document.getElementById('debugText');
    window.logToDebug = function(msg, isErr) {
        const t = new Date().toLocaleTimeString();
        const prefix = isErr ? '🔥 ERROR: ' : '';
        const line = `[${t}] ${prefix}${msg}`;
        window.logQueue.push(line);
        if (isErr) console.error(line);
        else console.log(line);
        if (window.debugDiv) window.debugDiv.innerText = window.logQueue.slice(-20).join('\n');
    };
    window.addEventListener('error', function(e) {
        let errorMsg = e.message;
        if (e.filename) errorMsg += ` at ${e.filename}:${e.lineno}:${e.colno}`;
        window.logToDebug(errorMsg, true);
    });
    window.addEventListener('unhandledrejection', function(e) {
        window.logToDebug(`Unhandled rejection: ${e.reason}`, true);
    });
    window.logToDebug('🚀 Logging system active');

    function safeSetInnerHTML(id, html) {
        const elem = document.getElementById(id);
        if (elem) elem.innerHTML = html;
        else window.logToDebug(`Element #${id} not found when setting innerHTML`, true);
    }
    function safeGetElement(id) {
        const elem = document.getElementById(id);
        if (!elem) window.logToDebug(`Element #${id} not found`, true);
        return elem;
    }

    // ---------- DYNAMIC SCRIPT LOADING ----------
    const CDN_LIST = [
        'https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js',
        'https://unpkg.com/three@0.128.0/build/three.min.js',
        'https://cdn.skypack.dev/three@0.128.0'
    ];
    let currentCdnIndex = 0;

    function loadThreeScript(src, callback, errorCallback) {
        const script = document.createElement('script');
        script.src = src;
        script.onload = () => { window.logToDebug(`✅ Three.js core loaded from ${src}`); callback(); };
        script.onerror = () => { window.logToDebug(`❌ Failed to load Three.js from ${src}`, true); errorCallback(); };
        document.head.appendChild(script);
    }

    function loadThreeWithFallback(callback) {
        if (currentCdnIndex >= CDN_LIST.length) {
            window.logToDebug('❌ All CDNs failed for Three.js core', true);
            safeSetInnerHTML('hoverContent', '<div class="error-message">Three.js failed to load.</div>');
            return;
        }
                console.log("ATTEMPTING CDN: " + CDN_LIST[currentCdnIndex]);
        loadThreeScript(CDN_LIST[currentCdnIndex], callback, () => { console.log("CDN FAILED: " + CDN_LIST[currentCdnIndex]); currentCdnIndex++; loadThreeWithFallback(callback); });
    }

    function loadAddon(src, name, callback) {
        const script = document.createElement('script');
        script.src = src;
        script.onload = () => { window.logToDebug(`✅ ${name} loaded from ${src}`); callback(); };
        script.onerror = () => { window.logToDebug(`❌ Failed to load ${name} from ${src}`, true); callback(); };
        document.head.appendChild(script);
    }

    window.logToDebug('Starting dynamic script loading...');
    loadThreeWithFallback(() => {
        window.logToDebug('Three.js core ready, loading add-ons...');
        let pending = 2;
        function done() { pending--; if (pending === 0) startApp(); }
        loadAddon('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js', 'OrbitControls', done);
        loadAddon('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/renderers/CSS2DRenderer.js', 'CSS2DRenderer', done);
    });

    async function startApp() {
        // ---------- ENVIRONMENT DETECTION & DYNAMIC API BASE ----------
        // Port from receipts-ocr project - allows GitHub Pages to reach local backend
        const getAPIBase = () => {
            if (typeof window === 'undefined') return 'http://localhost:8000';
            const hostname = window.location.hostname;
            // On GitHub Pages, explicitly target localhost
            if (hostname.includes('github.io')) return 'https://localhost:8443';
            // Local development
            if (hostname === 'localhost' || hostname === '127.0.0.1') return 'http://localhost:8000';
            // LAN access
            return `http://${hostname}:8000`;
        };
        const API_BASE = getAPIBase();
        window.logToDebug(`🌐 API base URL: ${API_BASE}`);
        window.logToDebug('Starting application...');
        try {
            const res = await fetch(`${API_BASE}/api/health`);
            if (res.ok) safeSetInnerHTML('status-area', '<div class="status-badge online">🟢 Server: Online</div>');
            else throw new Error(`Health check returned ${res.status}`);
        } catch(e) {
            window.logToDebug(`Health check failed: ${e.message}`, true);
            safeSetInnerHTML('status-area', '<div class="status-badge offline">🔴 Server: Offline (fallback)</div>');
        }

        let allRepos = [];
        try {
            const res = await fetch(`${API_BASE}/api/repos`);
            if (res.ok) allRepos = await res.json();
            else throw new Error(`/api/repos returned ${res.status}`);
            window.logToDebug(`✅ Loaded ${allRepos.length} repos from backend`);
        } catch(e) {
            window.logToDebug(`Repo fetch failed: ${e.message} – falling back to GitHub API`, true);
            const fallback = await fetch('https://api.github.com/users/swipswaps/repos?sort=pushed&direction=desc&per_page=50');
            const data = await fallback.json();
            allRepos = data.map(repo => ({ name: repo.name, language: repo.language || 'Unknown', stars: repo.stargazers_count || 0, url: repo.html_url, date: repo.pushed_at ? repo.pushed_at.slice(0,10) : '2026-01-01', description: repo.description || '', tags: [] }));
            window.logToDebug(`✅ Loaded ${allRepos.length} repos from GitHub fallback`);
        }

        const container = document.getElementById('canvas-container');
        const w = container.clientWidth, h = container.clientHeight;
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x050b1a);
        const camera = new THREE.PerspectiveCamera(45, w/h, 0.1, 1000);
        camera.position.set(0, 1.5, 13);
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(w, h);
        container.appendChild(renderer.domElement);
        const labelRenderer = new THREE.CSS2DRenderer();
        labelRenderer.setSize(w, h);
        labelRenderer.domElement.style.position = 'absolute';
        labelRenderer.domElement.style.top = '0px';
        labelRenderer.domElement.style.left = '0px';
        labelRenderer.domElement.style.pointerEvents = 'none';
        container.appendChild(labelRenderer.domElement);
        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.autoRotate = true;
        controls.autoRotateSpeed = 0.6;
        controls.target.set(0,0,0);
        const starGeo = new THREE.BufferGeometry();
        const starPos = new Float32Array(1500*3);
        for(let i=0;i<1500;i++) { starPos[i*3] = (Math.random()-0.5)*200; starPos[i*3+1] = (Math.random()-0.5)*100; starPos[i*3+2] = (Math.random()-0.5)*80-40; }
        starGeo.setAttribute('position', new THREE.BufferAttribute(starPos,3));
        const stars = new THREE.Points(starGeo, new THREE.PointsMaterial({color:0x88aaff, size:0.12}));
        scene.add(stars);
        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            stars.rotation.y += 0.0003;
            renderer.render(scene, camera);
            labelRenderer.render(scene, camera);
        }
        animate();
        window.addEventListener('resize', () => {
            const w = container.clientWidth, h = container.clientHeight;
            camera.aspect = w/h;
            camera.updateProjectionMatrix();
            renderer.setSize(w,h);
            labelRenderer.setSize(w,h);
        });
        window.logToDebug('✅ Three.js scene initialized');

        const radius = 5.5;
        const golden = (1+Math.sqrt(5))/2;
        let tagLabels = [];
        function getLanguageColor(lang) {
            const c = { JavaScript:'#f7df1e', TypeScript:'#3178c6', Python:'#3572A5', Shell:'#89e051', HTML:'#e34c26', CSS:'#563d7c' };
            return c[lang] || '#44aaff';
        }
        allRepos.forEach((repo, idx) => {
            const theta = 2 * Math.PI * idx / golden;
            const phi = Math.acos(1 - 2 * (idx+0.5) / allRepos.length);
            const x = Math.sin(phi) * Math.cos(theta) * radius;
            const y = Math.sin(phi) * Math.sin(theta) * radius * 0.6;
            const z = Math.cos(phi) * radius;
            const div = document.createElement('div');
            div.style.backgroundColor = 'rgba(18,18,31,0.95)';
            div.style.border = `2px solid ${getLanguageColor(repo.language)}`;
            div.style.borderRadius = '16px';
            div.style.padding = '8px 14px';
            div.style.textAlign = 'center';
            div.style.fontFamily = 'system-ui,sans-serif';
            div.style.color = '#ffffff';
            div.style.fontSize = '14px';
            div.style.fontWeight = '600';
            div.style.transition = 'all 0.1s ease';
            div.style.whiteSpace = 'nowrap';
            div.style.cursor = 'pointer';
            // Label divs intentionally keep pointer-events:none (inherited from the CSS2D
            // container, which is set to none above). That lets the WebGL canvas beneath
            // receive every drag event so OrbitControls rotation works anywhere — including
            // when the cursor is over a label. Clicks are NOT bound to the div (those
            // handlers could never fire while the div inherits pointer-events:none); they
            // are resolved by hit-testing in the window-level click/dblclick listeners below.
            const shortName = repo.name.length > 24 ? repo.name.slice(0,21)+'...' : repo.name;
            div.innerHTML = `<strong>${shortName}</strong><br><span style="font-size:11px; color:${getLanguageColor(repo.language)};">${repo.language} ★ ${repo.stars}</span><br><span style="font-size:9px; color:#88aacc;">${repo.date}</span>`;
            const label = new THREE.CSS2DObject(div);
            label.position.set(x,y,z);
            label.userData = { repo };
            scene.add(label);
            tagLabels.push(label);
        });
        window.logToDebug(`🎨 Created ${tagLabels.length} labels`);

        async function updateDisplay(repo) {
            const hoverDiv = safeGetElement('hoverContent');
            if (!hoverDiv) return;
            if (!repo) { hoverDiv.innerHTML = '<div class="empty-message">✨ Click any repository to lock it</div>'; return; }
            const savedScroll = safeGetElement('panel-scroll') ? document.getElementById('panel-scroll').scrollTop : 0;
            let html = `<div class="repo-current"><div class="repo-current-name">📁 ${repo.name}</div><div class="repo-current-details">${repo.language} · ⭐ ${repo.stars} stars · ${repo.date}</div>${repo.description ? `<div class="repo-current-details">${repo.description}</div>` : ''}</div>`;
            let related = allRepos.filter(r => r.name !== repo.name).slice(0,6);
            if (related.length) {
                html += `<div class="section-title">🔗 Related repositories</div>`;
                for (let rel of related) html += `<div class="related-item" onclick="window.open('${rel.url}','_blank')"><div class="related-name">${rel.name}</div><div class="related-lang">${rel.language} · ⭐ ${rel.stars}</div>${rel.description ? `<div class="related-desc">${rel.description.slice(0,80)}</div>` : ''}</div>`;
            } else html += `<div class="empty-message">No related repos found.</div>`;
            html += `<div class="section-title">📝 Common code pattern</div><div id="dynamic-code" class="code-snippet">Loading...</div>`;
            hoverDiv.innerHTML = html;
            if (safeGetElement('panel-scroll')) document.getElementById('panel-scroll').scrollTop = savedScroll;
            if (related.length) {
                try {
                    const resp = await fetch(`${API_BASE}/api/common-code?repo1=${encodeURIComponent(repo.name)}&repo2=${encodeURIComponent(related[0].name)}`);
                    if (resp.ok) {
                        const data = await resp.json();
                        const codeDiv = document.getElementById('dynamic-code');
                        if (data.common && data.common.length) {
                            const best = data.common[0];
                            codeDiv.innerHTML = `<strong>Pattern:</strong> ${best.pattern}<br><small>From ${repo.name}:</small> ${best.from_repo1}<br><small>From ${related[0].name}:</small> ${best.from_repo2}`;
                        } else if (codeDiv) codeDiv.innerHTML = 'No common patterns found.';
                    }
                } catch(e) { window.logToDebug(`common-code error: ${e.message}`, true); }
            }
        }

        // ---------- HIT-TEST HELPER ----------
        // Returns the label whose on-screen rectangle contains the given client point,
        // or null. Uses the same getBoundingClientRect approach as the hover handler so
        // hover and click agree on what is "under the cursor".
        function labelAtPoint(clientX, clientY) {
            for (let lbl of tagLabels) {
                const elem = lbl.element;
                if (!elem) continue;
                const rect = elem.getBoundingClientRect();
                if (clientX >= rect.left && clientX <= rect.right && clientY >= rect.top && clientY <= rect.bottom) {
                    return lbl;
                }
            }
            return null;
        }

        let currentHovered = null;
        window.addEventListener('mousemove', (e) => {
            let hoveredLabel = null;
            for (let lbl of tagLabels) {
                const elem = lbl.element;
                if (!elem) continue;
                const rect = elem.getBoundingClientRect();
                if (e.clientX >= rect.left && e.clientX <= rect.right && e.clientY >= rect.top && e.clientY <= rect.bottom) {
                    hoveredLabel = lbl;
                    break;
                }
            }
            if (hoveredLabel && hoveredLabel !== currentHovered) {
                if (currentHovered && currentHovered.element) currentHovered.element.style.border = '';
                currentHovered = hoveredLabel;
                if (hoveredLabel.element) hoveredLabel.element.style.border = '2px solid #5effe0';
                if (!window.selectedRepo) {
                    window.hoveredRepo = hoveredLabel.userData.repo;
                    updateDisplay(hoveredLabel.userData.repo);
                    window.logToDebug(`🖱️ Hover: ${hoveredLabel.userData.repo.name}`);
                }
            } else if (!hoveredLabel && currentHovered && !window.selectedRepo) {
                if (currentHovered.element) currentHovered.element.style.border = '';
                currentHovered = null;
                updateDisplay(null);
                window.logToDebug(`✨ Hover end`);
            }
        });

        // ---------- DRAG vs CLICK DISCRIMINATION ----------
        // OrbitControls rotation is a mousedown+drag+mouseup. The browser still fires a
        // 'click' after a small drag, which would lock a repo the user only meant to
        // rotate past. Track the pointer travel between mousedown and mouseup; if it moved
        // more than 5px in either axis, treat the gesture as a drag and ignore the click.
        let downX = 0, downY = 0, dragged = false;
        window.addEventListener('mousedown', (e) => {
            downX = e.clientX; downY = e.clientY; dragged = false;
        });
        window.addEventListener('mousemove', (e) => {
            // Only a held primary button counts as dragging. autoRotate slides labels under
            // a still cursor, firing mousemove with e.buttons === 0 — that must NOT set dragged.
            if (e.buttons !== 0 && (Math.abs(e.clientX - downX) > 5 || Math.abs(e.clientY - downY) > 5)) {
                dragged = true;
            }
        });

        // ---------- SINGLE-CLICK = LOCK / DOUBLE-CLICK = OPEN ----------
        // A double-click also fires two 'click' events first. To stop a single-click lock
        // from flashing during a double-click, the click action is deferred ~250ms; a
        // dblclick within that window cancels it and opens the repo instead.
        let clickTimer = null;
        window.addEventListener('click', (e) => {
            if (dragged) return; // user was rotating, not selecting
            const lbl = labelAtPoint(e.clientX, e.clientY);
            if (clickTimer) clearTimeout(clickTimer);
            clickTimer = setTimeout(() => {
                clickTimer = null;
                if (lbl) {
                    window.selectedRepo = lbl.userData.repo;
                    window.hoveredRepo = null;
                    updateDisplay(lbl.userData.repo);
                    window.logToDebug(`🔒 Locked: ${lbl.userData.repo.name}`);
                } else if (window.selectedRepo) {
                    // Click on empty space clears the lock and re-enables hover updates.
                    window.selectedRepo = null;
                    updateDisplay(null);
                    window.logToDebug(`🔓 Unlocked`);
                }
            }, 250);
        });
        window.addEventListener('dblclick', (e) => {
            if (clickTimer) { clearTimeout(clickTimer); clickTimer = null; }
            if (dragged) return;
            const lbl = labelAtPoint(e.clientX, e.clientY);
            if (!lbl) return;
            const repo = lbl.userData.repo;
            window.selectedRepo = repo;
            window.hoveredRepo = null;
            updateDisplay(repo);
            window.logToDebug(`🔒 Locked: ${repo.name}`);
            if (repo.url && repo.url !== '#') {
                window.open(repo.url, '_blank');
                window.logToDebug(`🔗 Opened: ${repo.name}`);
            }
        });

        window.performSearch = async function() {
    const q = document.getElementById('searchInput').value.trim();
    const mode = document.getElementById('searchMode').value;
    const resultsDiv = safeGetElement('searchResults');
    if (!resultsDiv) return;
    if (q.length < 2) { resultsDiv.innerHTML = '<div class="empty-message">Enter at least 2 characters</div>'; return; }
    window.logToDebug(`🔎 Searching: "${q}" (mode: ${mode})`);
    resultsDiv.innerHTML = `<div class="section-title">🔍 Results for "${q}"</div><div class="empty-message">Searching...</div>`;
    try {
        let url = '';
        if (mode === 'readme') {
            url = `/api/search-code?q=${encodeURIComponent(q)}`;
        } else {
            url = `/api/search-github?q=${encodeURIComponent(q)}`;
        }
        const resp = await fetch(url);
        if (!resp.ok) {
            const errText = await resp.text();
            throw new Error(`${resp.status}: ${errText.substring(0,100)}`);
        }
        const data = await resp.json();
        let results = [];
        if (mode === 'readme') {
            results = data.results || [];
            if (results.length) {
                let html = `<div class="section-title">🔍 Results for "${q}" (${results.length})</div>`;
                for (let res of results) {
                    const repoInfo = allRepos.find(r => r.name === res.repo_name);
                    const repoUrl = (repoInfo && repoInfo.url !== '#') ? repoInfo.url : '#';
                    html += `<div class="related-item" onclick="window.open('${repoUrl}','_blank')"><div class="related-name">📄 ${res.repo_name}</div><div class="related-desc">${res.content.slice(0,100)}...</div></div>`;
                }
                resultsDiv.innerHTML = html;
                window.logToDebug(`📋 Found ${results.length} results from READMEs`);
            } else {
                resultsDiv.innerHTML = `<div class="section-title">🔍 Results for "${q}"</div><div class="empty-message">No matches in READMEs.</div>`;
            }
        } else {
            // GitHub mode
            results = data.results || [];
            if (results.length) {
                let html = `<div class="section-title">🔍 Results for "${q}" (${data.total_count} total, showing ${results.length})</div>`;
                for (let res of results) {
                    html += `<div class="related-item" onclick="window.open('${res.url}','_blank')"><div class="related-name">📁 ${res.repo}</div><div class="related-desc">${res.file} (score: ${res.score.toFixed(2)})</div></div>`;
                }
                resultsDiv.innerHTML = html;
                window.logToDebug(`📋 Found ${results.length} code results from GitHub API`);
            } else {
                resultsDiv.innerHTML = `<div class="section-title">🔍 Results for "${q}"</div><div class="empty-message">No code matches found.</div>`;
            }
        }
    } catch(err) {
        resultsDiv.innerHTML = `<div class="empty-message">Search failed: ${err.message}</div>`;
        window.logToDebug(`Search error: ${err.message}`, true);
    }
}
        };
        document.getElementById('searchBtn').onclick = window.performSearch;
        document.getElementById('searchInput').onkeypress = (e) => { if (e.key === 'Enter') window.performSearch(); };
        document.addEventListener('contextmenu', (e) => true);
        window.toggleCollapsible = function(h) {
            const c = h.nextElementSibling;
            if (c) c.classList.toggle('active');
            const i = h.querySelector('.indicator');
            if (i) i.textContent = c && c.classList.contains('active') ? '▼' : '▶';
        };
        window.downloadLogs = () => {
            const blob = new Blob([window.logQueue.join('\n')], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `full_log_${Date.now()}.txt`;
            a.click();
            URL.revokeObjectURL(url);
            window.logToDebug('📁 Logs saved to file');
        };
        window.clearLogs = () => {
            window.logQueue = [];
            if (window.debugDiv) window.debugDiv.innerText = 'Logs cleared.';
            window.logToDebug('🗑️ Logs cleared');
        };
        document.getElementById('downloadLogs').onclick = window.downloadLogs;
        document.getElementById('clearLogs').onclick = window.clearLogs;
        window.logToDebug('🚀 Application ready. Single-click to lock, double-click to open GitHub.');
</script>
</body>
</html>
