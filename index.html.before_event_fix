<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>3D Code Portfolio – SwipSwaps</title>
    <style>
        body { margin: 0; overflow: hidden; font-family: monospace; }
        #info {
            position: absolute;
            top: 20px;
            left: 20px;
            color: white;
            background: rgba(0,0,0,0.6);
            padding: 10px 15px;
            border-radius: 8px;
            pointer-events: none;
            z-index: 10;
            font-size: 14px;
            backdrop-filter: blur(5px);
        }
        .instruction {
            position: absolute;
            bottom: 20px;
            right: 20px;
            color: #5effe0;
            background: rgba(0,0,0,0.5);
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 11px;
            pointer-events: none;
            z-index: 10;
        }
    </style>
<script src="slop-dashboard.js"></script>
</head>
<body>
    <div id="info">
        🔮 3D Repository Cloud<br>
        <span style="font-size: 10px;">Single-click: lock | Double-click: open GitHub</span>
    </div>
    <div class="instruction">✨ Drag to rotate | Scroll to zoom</div>

    <!-- Search Bar with inline button and token dropdown -->
    <div style="position: fixed; top: 20px; left: 20px; right: 20px; z-index: 100; background: rgba(0,0,0,0.8); padding: 15px; border-radius: 60px; backdrop-filter: blur(10px); border: 1px solid #2a2a3e;">
        <div style="display: flex; gap: 12px; align-items: center; max-width: 1200px; margin: 0 auto;">
            <input type="text" id="searchInput" placeholder="🔎 Search code snippets..." style="flex: 2; background: transparent; border: none; color: white; font-family: monospace; font-size: 14px; padding: 12px; outline: none;">
            <select id="searchMode" style="background: #1a1a2e; color: white; border: 1px solid #5effe0; border-radius: 30px; padding: 8px 16px; font-size: 12px; cursor: pointer;">
                <option value="readme">📄 Search READMEs (local)</option>
                <option value="github">🔍 Search code (GitHub API) – requires local backend running</option>
                <option value="semantic">🧠 Semantic Search (local AI)</option>
                <option value="token">🔑 Set GitHub Token</option>
            </select>
            <button id="searchBtn" style="background: #2e7d64; color: white; border: none; border-radius: 50%; width: 44px; height: 44px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 20px; transition: transform 0.2s;">🔍</button>
        </div>
    </div>

    <!-- Debug panel -->
    <div id="debug-panel" style="position: fixed; bottom: 20px; left: 20px; width: 350px; max-height: 200px; background: rgba(0,0,0,0.7); border-radius: 8px; padding: 10px; font-size: 10px; font-family: monospace; color: #0f0; overflow-y: auto; z-index: 100; pointer-events: none;"></div>

    <script type="module">
        // 🐞 BUILD MARKER for stale tab detection
        const BUILD_MARKER = '🐞_HTML_20260527_1500';

        function logVerbose(msg) {
            const timestamp = new Date().toLocaleTimeString();
            const logMsg = `[${timestamp}] ${BUILD_MARKER} ${msg}`;
            console.log(logMsg);
            const debugPanel = document.getElementById('debug-panel');
            if (debugPanel) {
                debugPanel.innerHTML += `<div>${logMsg}</div>`;
                debugPanel.scrollTop = debugPanel.scrollHeight;
            }
        }

        logVerbose('🚀 Starting application (HTML version)');
        logVerbose('🧠 Initializing Three.js');

        // --- Three.js Cloud Setup ---
        import * as THREE from 'https://cdn.skypack.dev/three@0.128.0/build/three.module.js';
        import { OrbitControls } from 'https://cdn.skypack.dev/three@0.128.0/examples/jsm/controls/OrbitControls.js';
        import { CSS2DRenderer, CSS2DObject } from 'https://cdn.skypack.dev/three@0.128.0/examples/jsm/renderers/CSS2DRenderer.js';

        let scene, camera, renderer, labelRenderer, controls, cloudGroup;
        let repos = [];

        function initThree() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x050510);
            scene.fog = new THREE.FogExp2(0x050510, 0.008);

            camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(15, 10, 20);
            camera.lookAt(0, 0, 0);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            document.body.appendChild(renderer.domElement);

            labelRenderer = new CSS2DRenderer();
            labelRenderer.setSize(window.innerWidth, window.innerHeight);
            labelRenderer.domElement.style.position = 'absolute';
            labelRenderer.domElement.style.top = '0px';
            labelRenderer.domElement.style.left = '0px';
            labelRenderer.domElement.style.pointerEvents = 'none';
            document.body.appendChild(labelRenderer.domElement);

            controls = new OrbitControls(camera, renderer.domElement);

            // Add drag event logging
            controls.addEventListener('start', () => logVerbose('🖱️ DRAG START - Rotating cloud'));
            controls.addEventListener('end', () => logVerbose('🖱️ DRAG END - Rotation complete'));

            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.autoRotate = true;
            controls.autoRotateSpeed = 1.0;
            controls.enableZoom = true;
            controls.enablePan = true;

            logVerbose('✅ Three.js scene initialized');
        }

        function createCloud() {
            if (cloudGroup) scene.remove(cloudGroup);
            cloudGroup = new THREE.Group();
            const geometry = new THREE.SphereGeometry(0.4, 16, 16);
            const material = new THREE.MeshStandardMaterial({ color: 0x5effe0, emissive: 0x1a4d40 });

            repos.forEach((repo) => {
                const sphere = new THREE.Mesh(geometry, material.clone());
                const phi = Math.acos(2 * Math.random() - 1);
                const theta = 2 * Math.PI * Math.random();
                const radius = 8;
                sphere.userData = { repo: repo.name };
                sphere.position.x = radius * Math.sin(phi) * Math.cos(theta);
                sphere.position.y = radius * Math.sin(phi) * Math.sin(theta);
                sphere.position.z = radius * Math.cos(phi);

                const div = document.createElement('div');
                div.textContent = repo.name.length > 25 ? repo.name.substring(0, 22) + '...' : repo.name;
                div.style.color = '#5effe0';
                div.style.fontSize = '12px';
                div.style.fontFamily = 'monospace';
                div.style.background = 'rgba(0,0,0,0.7)';
                div.style.padding = '4px 8px';
                div.style.borderRadius = '20px';
                div.style.border = '1px solid #5effe0';
                div.style.cursor = 'pointer';
                div.style.whiteSpace = 'nowrap';
                div.onclick = () => { logVerbose(`🖱️ CLICK - Repository: ${repo.name}`); lockRepository(repo.name); if(window.SlopDashboard) new window.SlopDashboard(repo.name); };
                div.ondblclick = () => window.open(`https://github.com/swipswaps/${repo.name}`, '_blank');

                const label = new CSS2DObject(div);
                label.position.copy(sphere.position);

                cloudGroup.add(sphere);
                cloudGroup.add(label);
            });

            scene.add(cloudGroup);
            logVerbose(`🎨 Created ${repos.length} labels`);
        }

        function lockRepository(repoName) {
            logVerbose(`🔒 Locked: ${repoName}`);
            const spheres = cloudGroup.children.filter(c => c.isMesh);
            spheres.forEach(sphere => {
                if (sphere.userData.repo === repoName) {
                    sphere.material.emissive.setHex(0xff3366);
                    sphere.scale.set(1.5, 1.5, 1.5);
                    setTimeout(() => {
                        sphere.material.emissive.setHex(0x1a4d40);
                        sphere.scale.set(1, 1, 1);
                    }, 1000);
                }
            });
        }

        async function loadRepos() {
            try {
                const response = await fetch('/api/repos');
                const data = await response.json();
                repos = data.repos || [];
                logVerbose(`✅ Loaded ${repos.length} repos from backend`);
                createCloud();
            } catch (err) {
                logVerbose(`❌ Failed to load repos: ${err.message}`);
                repos = [{ name: 'example-repo-1' }, { name: 'example-repo-2' }];
                createCloud();
            }
        }

        // --- Search Logic with token dropdown ---
        const searchInput = document.getElementById('searchInput');
        const searchMode = document.getElementById('searchMode');
        const searchBtn = document.getElementById('searchBtn');

        async function performSearch() {
            const query = searchInput.value.trim();
            const mode = searchMode.value;
            logVerbose(`🔍 Searching: "${query}" in mode: ${mode}`);

            if (mode === 'token') {
                const newToken = prompt('Enter your GitHub Personal Access Token (classic, no scopes needed):');
                if (newToken && newToken.trim() !== '') {
                    localStorage.setItem('github_token', newToken.trim());
                    logVerbose('✅ Token saved to localStorage');
                    alert('Token saved. Select a search mode to continue.');
                    searchMode.value = 'readme';
                } else if (newToken === '') {
                    localStorage.removeItem('github_token');
                    logVerbose('⚠️ Token removed');
                    alert('Token removed.');
                }
                return;
            }

            if (!query) {
                logVerbose('⚠️ Empty search query');
                return;
            }

            if (mode === 'readme') {
                const results = repos.filter(r => r.name.toLowerCase().includes(query.toLowerCase()));
                logVerbose(`📄 Found ${results.length} matching repos locally`);
                if (results.length) alert('Found: ' + results.map(r => r.name).join(', '));
                else alert('No matches');
            } else if (mode === 'github') {
                const token = localStorage.getItem('github_token');
                if (!token) {
                    alert('Please set GitHub token first (select "Set GitHub Token" from dropdown)');
                    logVerbose('❌ No GitHub token found');
                    return;
                }
                try {
                    const response = await fetch(
                        `https://api.github.com/search/code?q=${encodeURIComponent(query)}+repo:swipswaps/*`,
                        { headers: { 'Authorization': `token ${token}` } }
                    );
                    const data = await response.json();
                    const count = data.items ? data.items.length : 0;
                    logVerbose(`🐙 GitHub found ${count} results`);
                    alert(`GitHub search returned ${count} results (see console).`);
                } catch (err) {
                    logVerbose(`❌ GitHub search failed: ${err.message}`);
                    alert('GitHub search failed: ' + err.message);
                }
            } else if (mode === 'semantic') {
                logVerbose('🧠 Semantic search not yet implemented in HTML version');
                alert('Semantic search coming soon.');
            }
        }

        searchBtn.addEventListener('click', performSearch);
        searchInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') performSearch(); });

        // Initialize everything
        initThree();
        loadRepos();

        // Animation loop
        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            renderer.render(scene, camera);
            labelRenderer.render(scene, camera);
        }
        animate();

        window.addEventListener('resize', onWindowResize, false);
        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
            labelRenderer.setSize(window.innerWidth, window.innerHeight);
        }
        logVerbose('🎨 HTML/Three.js app ready');
    </script>
</body>
</html>
